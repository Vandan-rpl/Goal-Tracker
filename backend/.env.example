# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (SQL Server) ---
# NOTE: config/db.js (the file actually used everywhere) reads DB_DATABASE.
# A separate, unused file (config/env.js) reads DB_NAME instead — nothing
# requires config/env.js, so it's dead code, but if you ever wire it in,
# you'd need DB_NAME set too. Set DB_DATABASE; DB_NAME is not currently load-bearing.
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=goal_tracker
DB_USER=sa
DB_PASSWORD=change_me
DB_ENCRYPT=false

# --- JWT ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h

# --- Frontend origin (used for BOTH Express CORS and Socket.IO CORS) ---
FRONTEND_URL=http://localhost:5173

# --- Email (nodemailer, used by notifyService.js) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_app_password