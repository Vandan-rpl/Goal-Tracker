# Base REST API URL (must include /api/v1 — server.js mounts everything there)
VITE_API_URL=http://localhost:5000/api/v1

# Socket.IO server origin — NOT the same as VITE_API_URL, this is the bare
# origin with no /api/v1 path (Socket.IO uses its own /socket.io path).
# Optional — defaults to http://localhost:5000 if unset.
VITE_SOCKET_URL=http://localhost:5000

# Cosmetic only — shown in Footer.jsx, all have safe fallbacks if unset.
VITE_APP_NAME=Goal Tracker
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development